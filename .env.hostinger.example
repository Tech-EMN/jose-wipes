# =============================================================================
# José Wipes Web Video Studio — Variáveis de Ambiente (Hostinger Docker Manager)
# =============================================================================
# Copie este arquivo como referência ao cadastrar as variáveis no
# Docker Manager da Hostinger. NÃO commite valores reais no repositório.
# =============================================================================

# ---- Domínio e Autenticação ----
TRAEFIK_HOST=studio.seudominio.com
TRAEFIK_BASIC_AUTH_USERS=usuario:$$apr1$$hashgerado

# ---- API Keys (SECRETS — use o vault do Docker Manager) ----
HF_API_KEY=
HF_API_SECRET=
OPENAI_API_KEY=
OPENAI_PLANNER_MODEL=gpt-4.1-mini
ELEVENLABS_API_KEY=

# ---- Autenticação da Aplicação (F3) ----
JW_API_KEY=
JW_AUTH_STRICT=false

# ---- Google Drive (produção: service account + Shared Drive) ----
GOOGLE_SERVICE_ACCOUNT_FILE=/app/credentials/service-account.json
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_HOST_PATH=/opt/jose-wipes/credentials/service-account.json

# ---- Runtime ----
TZ=America/Sao_Paulo
PYTHONUNBUFFERED=1

# ---- Worker (F14 — containers separados) ----
JW_WORKER_POLL_INTERVAL=2
JW_WORKER_GRACE=30
JW_HIGGSFIELD_POLL_INTERVAL_SECONDS=5
JW_HIGGSFIELD_POLL_TIMEOUT_SECONDS=360
JW_HIGGSFIELD_READ_RETRIES=5

# ---- Rate Limiting (F5) ----
JW_RATE_LIMIT_JOBS=5
JW_RATE_LIMIT_WINDOW_SECONDS=60

# ---- Moderação (F6) ----
JW_MODERATION_ENABLED=true
JW_MODERATION_OPENAI=true
JW_MODERATION_STRICT=false

# ---- FFmpeg (F7) ----
JW_FFMPEG_TIMEOUT=300

# =============================================================================
# GitHub Actions Secrets (para CI/CD — F8)
# =============================================================================
# No repositório GitHub: Settings → Secrets and variables → Actions
#
# Secrets:
#   HOSTINGER_API_KEY      — chave da API Hostinger
#   TRAEFIK_BASIC_AUTH_USERS
#   HF_API_KEY
#   HF_API_SECRET
#   OPENAI_API_KEY
#   ELEVENLABS_API_KEY
#   JW_API_KEY
#
# Variables:
#   HOSTINGER_VM_ID        — ID do VPS no painel Hostinger
#   TRAEFIK_HOST           — studio.seudominio.com
#   OPENAI_PLANNER_MODEL   — gpt-4.1-mini
# =============================================================================
